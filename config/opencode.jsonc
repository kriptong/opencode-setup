{
  "plugin": [
    "oh-my-openagent@latest"
  ],
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama-lan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama LAN",
      "options": {
        "baseURL": "http://192.168.180.199:8900/v1"
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B"
        }
      }
    }
  },
  "skills": {
    "sources": [
      "~/.config/opencode/skills"
    ]
  },
  "mcp": {
    "sqz": {
      "command": [
        "C:/Program Files/nodejs/node.exe",
        "C:/Users/usano/.config/opencode/node_modules/sqz-cli/bin/sqz-mcp",
        "--transport",
        "stdio"
      ],
      "enabled": true,
      "type": "local"
    },
    "github": {
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/github"
      ],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      },
      "enabled": false,
      "type": "local"
    },
    "playwright": {
      "command": [
        "C:/Program Files/nodejs/node.exe",
        "C:/Users/usano/.config/opencode/node_modules/@playwright/mcp/cli.js"
      ],
      "enabled": true,
      "type": "local"
    },
    "sequential-thinking": {
      "command": [
        "npx",
        "-y",
        "@anthropic/mcp-sequential-thinking"
      ],
      "enabled": false,
      "type": "local"
    },
    "filesystem": {
      "command": [
        "C:/Program Files/nodejs/node.exe",
        "C:/Users/usano/.config/opencode/node_modules/@modelcontextprotocol/server-filesystem/dist/index.js",
        "C:/Projects",
        "C:/Users/usano/OneDrive"
      ],
      "enabled": true,
      "type": "local"
    },
    "memory": {
      "command": [
        "C:/Program Files/nodejs/node.exe",
        "C:/Users/usano/.config/opencode/node_modules/@modelcontextprotocol/server-memory/dist/index.js"
      ],
      "enabled": true,
      "type": "local",
      "env": {
        "MEMORY_FILE_PATH": "C:/Users/usano/.config/opencode/memory.jsonl"
      }
    },
    "serena": {
      "command": [
        "C:/Users/usano/.local/bin/serena.exe",
        "start-mcp-server",
        "--transport",
        "stdio"
      ],
      "enabled": true,
      "type": "local"
    }
  }
}
